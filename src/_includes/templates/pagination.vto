{{ if pagination.pages.length > 1 }}
<nav class="page-pagination pagination">
  <ul>
    {{ if pagination.href.previous }}
    <li class="pagination-prev">
      <a href="{{ pagination.href.previous }}" rel="prev">{{ site.i18n.nav.previous }}</a>
    </li>
    {{ /if }}

    <li class="pagination-page">
      {{ site.i18n.nav.page }} {{ pagination.pageNumber + 1 }}
    </li>

    {{ if pagination.href.next }}
    <li class="pagination-next">
      <a href="{{ pagination.href.next }}" rel="next">{{ site.i18n.nav.next }}</a>
    </li>
    {{ /if }}
  </ul>
</nav>
{{ /if }}
