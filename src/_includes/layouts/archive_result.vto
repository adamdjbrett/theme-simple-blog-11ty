---
layout: base.vto
bodyClass: body-tag
---
<header class="page-header">
  <p><a href="/archive/">{{ site.i18n.nav.back }}</a></p>
  <h1 class="page-title">{{ title }}</h1>
</header>

{{ include "templates/post-list.vto" { postslist: results } }}

{{ if pager?.totalPages > 1 }}
<nav class="page-pagination pagination">
  <ul>
    {{ if pager.previous }}
    <li class="pagination-prev">
      <a href="{{ pager.previous }}" rel="prev">{{ site.i18n.nav.previous }}</a>
    </li>
    {{ /if }}

    <li class="pagination-page">
      {{ site.i18n.nav.page }} {{ pager.pageNumber }}
    </li>

    {{ if pager.next }}
    <li class="pagination-next">
      <a href="{{ pager.next }}" rel="next">{{ site.i18n.nav.next }}</a>
    </li>
    {{ /if }}
  </ul>
</nav>
{{ /if }}
