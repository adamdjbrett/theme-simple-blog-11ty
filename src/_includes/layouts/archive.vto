---
layout: base.vto
bodyClass: body-tag
---
<header class="page-header">
  <h1 class="page-title">{{ title }}</h1>
</header>

{{ if pagination.pageNumber === 0 }}
{{ if collections.authorList.length > 1 }}
<nav class="page-navigation">
  <h2>{{ site.i18n.search.authors }}:</h2>

  <ul class="page-navigation-tags">
  {{ for author of collections.authorList }}
    <li><a href="{{ author |> authorUrl }}" class="badge">{{ author }}</a></li>
  {{ /for }}
  </ul>
</nav>
{{ /if }}

{{ if collections.tagList.length }}
<nav class="page-navigation">
  <h2>{{ site.i18n.search.tags }}:</h2>

  <ul class="page-navigation-tags">
  {{ for tag of collections.tagList }}
    <li><a href="{{ tag |> tagUrl }}" class="badge">{{ tag }}</a></li>
  {{ /for }}
  </ul>
</nav>
{{ /if }}
{{ /if }}

{{ include "templates/post-list.vto" { postslist: results } }}
{{ include "templates/pagination.vto" }}
